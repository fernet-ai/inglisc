{
  "name": "inglisc",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "dev:all": "npx concurrently \"cd ../inglisc-be && npm start\" \"npm run dev\"",
    "test": "node --test test/*.test.js",
    "build:web": "expo export --platform web --output-dir dist",
    "build:android": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "submit:android:production": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/stack": "^7.12.2",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.15.5",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "concurrently": "^10.0.7"
  },
  "private": true
}
